PORT=5001
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=scholarship_db
DB_PORT=3306
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
NODE_ENV=development
# ---- SMTP (pick ONE provider) ----
# Option A (recommended): Brevo SMTP relay — higher throughput, verified senders, domain branding
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Brevo SMTP relay login (from your Brevo dashboard -> SMTP & API)
SMTP_USER=your_Brevo_smtp_login@smtp-brevo.com
# Brevo SMTP key (from your Brevo dashboard -> SMTP & API). Treat like a password.
SMTP_PASS=your_Brevo_SMTP_key
# Verified sender address in Brevo (your signup email or a verified domain alias)
SMTP_FROM=your_verified_sender@example.com
SMTP_FROM_NAME=EduGrant Portal
#
# Option B: Gmail SMTP relay (local/dev only — STRICT Google limits, see notes below)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587            # or 465 with SMTP_SECURE=true (SSL)
# SMTP_SECURE=false        # false=587/STARTTLS, true=465/SSL
# SMTP_USER=you@gmail.com  # the Gmail account itself
# SMTP_PASS=<16-char "App Password", NOT your Gmail password>
# SMTP_FROM=you@gmail.com  # MUST match SMTP_USER (Gmail rejects other From addresses)
# SMTP_FROM_NAME=EduGrant Portal
# Invite link base served from the React client (the /setup-account route).
# Local dev: CLIENT_HOST=localhost, CLIENT_PORT=3000, CLIENT_PROTOCOL=http
# Public demo via a tunnel (localtunnel/ngrok): set CLIENT_HOST=<tunnel host>,
#   CLIENT_PORT=443, CLIENT_PROTOCOL=https. The port is omitted from the link
#   when it is the default for the protocol (443 for https, 80 for http).
CLIENT_HOST=localhost
CLIENT_PORT=3000
CLIENT_PROTOCOL=http
#
# Committee review decision policy: number of independent reviews required
# before an application's status can flip (1 = single reviewer decides).
COMMITTEE_QUORUM=1

# --- Selection & Awarding (slot-model v2) ---
# Days an awardee has to accept the scholarship before the award is forfeited
# and the slot is offered to the top-ranked waitlisted applicant.
AWARD_ACCEPTANCE_DAYS=7
# How many ranks below the cutoff are kept on the waitlist (ranks N+1..N+window).
WAITLIST_WINDOW=10
