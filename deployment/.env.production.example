# ============================================================
# Production .env for the Scholarship app (Hostinger VPS).
#
# Copy to /var/www/scholarship/server/.env on the server and
# fill in your real values. The backend loads this file itself
# (dotenv), but relevant secrets are also listed here so you can
# set them once via PM2 / systemd if you prefer.
#
# Generate secrets:
#   openssl rand -hex 32        # JWT_SECRET
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Database (PostgreSQL). Prefer a single DATABASE_URL ---
# Option A: connection string (cleanest)
DATABASE_URL=postgresql://scholarship_user:YOUR_STRONG_DB_PASSWORD@localhost:5432/scholarship_db
# Option B: individual components (db.js builds the URL from these when
#           DATABASE_URL is absent; DB_PORT defaults to 5432 for pg)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=scholarship_user
# DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
# DB_NAME=scholarship_db

# --- Auth ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# --- Client / CORS & invite links ---
# Base URL users type in the browser
CLIENT_URL=https://amora.bscs4a.com
CLIENT_HOST=amora.bscs4a.com
CLIENT_PORT=443
CLIENT_PROTOCOL=https

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# --- Committee decision policy ---
COMMITTEE_QUORUM=1

# --- Selection & awarding (slot-model) ---
AWARD_ACCEPTANCE_DAYS=7
WAITLIST_WINDOW=10

# --- SMTP (only if you enable email invites/notifications) ---
# Option A (recommended): Brevo SMTP relay
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_Brevo_smtp_login@smtp-brevo.com
SMTP_PASS=your_Brevo_SMTP_key
SMTP_FROM=your_verified_sender@example.com
SMTP_FROM_NAME=EduGrant Portal
# Option B: Gmail app password (dev only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=<16-char app password>
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=EduGrant Portal
